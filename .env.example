# Groq gives the best Hinglish transcription. A free key takes a minute:
#   https://console.groq.com/keys
# Copy this file to ".env" and paste your key below.
GROQ_API_KEY=

# Optional: change the API server port (the web app proxies to it).
# PORT=5180

# Optional override. Hinglish automatically uses whisper-large-v3 for accuracy;
# other languages use whisper-large-v3-turbo for speed.
# GROQ_WHISPER_MODEL=whisper-large-v3

# --- AI Command Center ---
# Separate key from transcription so quota and rotation stay independent.
# AI_PROVIDER=groq          # groq | xai
# AI_API_KEY=
# AI_MODEL=openai/gpt-oss-120b

# Groq Hinglish Normalization & Vocabulary Cleanup Model
# Default: openai/gpt-oss-120b (fast, accurate Roman Hinglish with JSON mode)
GROQ_HINGLISH_MODEL=openai/gpt-oss-120b

# OpenRouter Secondary AI Provider
OPENROUTER_API_KEY=
PRIMARY_AI_PROVIDER=groq
PRIMARY_AI_MODEL=openai/gpt-oss-120b
SECONDARY_AI_PROVIDER=openrouter
SECONDARY_AI_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
